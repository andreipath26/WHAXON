{
  "tools": [
    {
      "id": "nmap",
      "name": "Nmap",
      "category": "recon",
      "binary": "nmap",
      "description": "Network mapper",
      "args": "-sT -sV --exclude-ports 3000,5000,5001 {target}",
      "package": "nmap"
    },
    {
      "id": "nikto",
      "name": "Nikto",
      "category": "web",
      "binary": "nikto",
      "description": "Web server scanner",
      "args": "-h {target} -nointeractive",
      "package": "nikto",
      "pivot_capable": true
    },
    {
      "id": "gobuster",
      "name": "Gobuster",
      "category": "web",
      "binary": "gobuster",
      "description": "Directory/DNS busting",
      "args": "dir -u http://{target} -w /usr/share/wordlists/dirb/common.txt -q --no-error",
      "package": "gobuster",
      "pivot_capable": true
    },
    {
      "id": "echo",
      "name": "Echo (test)",
      "category": "test",
      "binary": "/bin/echo",
      "description": "Test tool",
      "args": "{target}",
      "package": ""
    },
    {
      "id": "sqlmap",
      "name": "SQLmap",
      "category": "web",
      "binary": "sqlmap",
      "description": "SQL injection scanner",
      "args": "-u {target} --batch --crawl=1 --level=1 --risk=1",
      "package": "sqlmap",
      "pivot_capable": true
    },
    {
      "id": "whois",
      "name": "WHOIS",
      "category": "recon",
      "binary": "whois",
      "description": "Domain registration lookup",
      "args": "{target}",
      "package": "whois"
    },
    {
      "id": "dig",
      "name": "dig",
      "category": "recon",
      "binary": "dig",
      "description": "DNS lookup",
      "args": "+short ANY {target}",
      "package": "dnsutils"
    },
    {
      "id": "nuclei",
      "name": "Nuclei",
      "category": "web",
      "binary": "nuclei",
      "description": "Template-based vulnerability scanner",
      "args": "-u {target} -silent -no-color -disable-update-check",
      "package": "",
      "pivot_capable": true
    },
    {
      "id": "ffuf",
      "name": "ffuf",
      "category": "web",
      "binary": "ffuf",
      "description": "Fast web fuzzer",
      "args": "-u {target}/FUZZ -w /usr/share/wordlists/dirb/common.txt -mc 200,204,301,302,307,401,403 -s",
      "package": "ffuf",
      "pivot_capable": true
    },
    {
      "id": "wpscan",
      "name": "WPScan",
      "category": "web",
      "binary": "wpscan",
      "description": "WordPress vulnerability scanner",
      "args": "--url {target} --no-banner --no-update",
      "package": "wpscan"
    },
    {
      "id": "impacket",
      "name": "Impacket",
      "category": "exploit",
      "binary": "impacket-secretsdump",
      "available": true,
      "package": "pip install impacket"
    },
    {
      "id": "theharvester",
      "name": "theHarvester",
      "category": "recon",
      "binary": "theHarvester",
      "description": "OSINT: hostnames and emails from public sources",
      "args": "-d {target} -b duckduckgo -l 500",
      "package": "theharvester",
      "outfile_flag": "-f"
    },
    {
      "id": "dnsrecon",
      "name": "dnsrecon",
      "category": "recon",
      "binary": "dnsrecon",
      "description": "DNS record enumeration",
      "args": "-d {target} -t std",
      "package": "dnsrecon",
      "outfile_flag": "-j"
    },
    {
      "id": "msf_sysinfo",
      "name": "MSF sysinfo",
      "category": "session",
      "transport": "msf_session",
      "command": "sysinfo",
      "description": "Collect system information from a Metasploit session",
      "binary": "",
      "args": "",
      "package": "",
      "required_session_type": "meterpreter"
    },
    {
      "id": "msf_getuid",
      "name": "MSF getuid",
      "category": "session",
      "transport": "msf_session",
      "command": "getuid",
      "description": "Show the current user on a Metasploit session",
      "binary": "",
      "args": "",
      "package": ""
    },
    {
      "id": "msf_hashdump",
      "name": "MSF hashdump",
      "category": "session",
      "transport": "msf_session",
      "command": "hashdump",
      "description": "Dump local password hashes from a Metasploit session",
      "binary": "",
      "args": "",
      "package": "",
      "required_session_type": "meterpreter"
    },
    {
      "id": "ssh_cmd",
      "name": "SSH command",
      "category": "session",
      "transport": "ssh",
      "command": "{command}",
      "description": "Run a command over an SSH connection (session_id: ssh:user@host[:port])",
      "binary": "",
      "args": "",
      "package": ""
    },
    {
      "id": "smb_shares",
      "name": "SMB shares",
      "category": "session",
      "transport": "smb",
      "command": "shares",
      "description": "List SMB shares (session_id: smb:user@host[:port])",
      "binary": "",
      "args": "",
      "package": ""
    },
    {
      "id": "smb_ls",
      "name": "SMB list",
      "category": "session",
      "transport": "smb",
      "command": "use whaxon\\nls",
      "description": "Select the whaxon share and list its root (session_id: smb:user@host[:port])",
      "binary": "",
      "args": "",
      "package": ""
    }
  ]
}
