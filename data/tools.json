{
  "tools": [
    {
      "id": "nmap",
      "name": "Nmap",
      "category": "recon",
      "binary": "nmap",
      "description": "Network mapper",
      "args": "-sT {target}",
      "package": "nmap"
    },
    {
      "id": "nikto",
      "name": "Nikto",
      "category": "web",
      "binary": "nikto",
      "description": "Web server scanner",
      "args": "-h {target} -nointeractive",
      "package": "nikto"
    },
    {
      "id": "gobuster",
      "name": "Gobuster",
      "category": "web",
      "binary": "gobuster",
      "description": "Directory/DNS busting",
      "args": "dir -u http://{target} -w /usr/share/wordlists/dirb/common.txt -q --no-error",
      "package": "gobuster"
    },
    {
      "id": "echo",
      "name": "Echo (test)",
      "category": "test",
      "binary": "/bin/echo",
      "description": "Test tool",
      "args": "{target}",
      "package": ""
    },
    {
      "id": "sqlmap",
      "name": "SQLmap",
      "category": "web",
      "binary": "sqlmap",
      "description": "SQL injection scanner",
      "args": "-u {target} --batch --crawl=1 --level=1 --risk=1",
      "package": "sqlmap"
    },
    {
      "id": "whois",
      "name": "WHOIS",
      "category": "recon",
      "binary": "whois",
      "description": "Domain registration lookup",
      "args": "{target}",
      "package": "whois"
    },
    {
      "id": "dig",
      "name": "dig",
      "category": "recon",
      "binary": "dig",
      "description": "DNS lookup",
      "args": "+short ANY {target}",
      "package": "dnsutils"
    },
    {
      "id": "nuclei",
      "name": "Nuclei",
      "category": "web",
      "binary": "nuclei",
      "description": "Template-based vulnerability scanner",
      "args": "-u {target} -silent -no-color -disable-update-check",
      "package": ""
    },
    {
      "id": "ffuf",
      "name": "ffuf",
      "category": "web",
      "binary": "ffuf",
      "description": "Fast web fuzzer",
      "args": "-u {target}/FUZZ -w /usr/share/wordlists/dirb/common.txt -mc 200,204,301,302,307,401,403 -s",
      "package": "ffuf"
    },
    {
      "id": "wpscan",
      "name": "WPScan",
      "category": "web",
      "binary": "wpscan",
      "description": "WordPress vulnerability scanner",
      "args": "--url {target} --no-banner --no-update",
      "package": "wpscan"
    }
  ]
}