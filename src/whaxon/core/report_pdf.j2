<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>WHAXON Report — {{ report.engagement }}</title>
<style>
{% if mode == 'print' %}
{{ print_css }}
{% else %}
{{ screen_css }}
{% endif %}
</style>
</head>
<body class="mode-{{ mode }}">

{% if mode == 'print' %}
<section class="cover">
  <div class="cover-brand">WHAXON</div>
  <div class="cover-engagement">{{ report.engagement }}</div>
  {% if meta.client %}<div class="cover-client">Prepared for {{ meta.client }}</div>{% endif %}
  {% if meta.prepared_by %}<div class="cover-by">Prepared by {{ meta.prepared_by }}</div>{% endif %}
  <div class="cover-date">{{ report.generated }}</div>
  <div class="cover-class">{{ meta.classification }}</div>
</section>
{% endif %}

<header class="report-header">
  <div class="engagement">{{ report.engagement }}</div>
  <div class="meta">Generated {{ report.generated }} · {{ report.job_count }} jobs · {{ report.finding_count }} findings</div>
</header>

<div class="donut">{{ donut_svg | safe }}</div>

<section class="exec-brief">
  <h2>Executive Brief</h2>
  {{ exec_brief_html | safe }}
</section>

<section class="roadmap">
  <h2>Remediation Roadmap</h2>
  {{ roadmap_html | safe }}
</section>

<section class="findings">
  <h2>Findings</h2>
  {% for sev, items in findings_by_severity.items() %}
    {% if items %}
    <div class="sev-group sev-{{ sev }}">
      <h3>{{ sev|capitalize }} ({{ items|length }})</h3>
      {% for f in items %}
      <article class="finding-card sev-{{ sev }}">
        <div class="finding-head">
          <span class="sev-chip">{{ f.severity }}{% if f.business_impact %} / Business: {{ f.business_impact }}{% endif %}</span>
          <span class="finding-kind">{{ f.kind }}</span>
        </div>
        <div class="finding-title">{{ f.raw_line }}</div>
        <div class="finding-meta">
          {% if f.target %}<span>target: {{ f.target }}</span>{% endif %}
          {% if f.cve %}<span>{{ f.cve }}</span>{% endif %}
          {% if f.count and f.count > 1 %}<span>seen {{ f.count }}x</span>{% endif %}
        </div>
        {% if f.remediation %}<div class="finding-remediation">{{ f.remediation }}</div>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% endif %}
  {% endfor %}
</section>

<section class="appendices">
  <h2>Appendix: Technical Findings</h2>
  {{ appendix_html | safe }}

  <h2>Appendix: Job History</h2>
  {{ job_history_html | safe }}
</section>

{% if mode == 'print' %}
<footer class="report-footer">
  <span class="foot-class">{{ meta.classification }}</span>
  <span class="foot-engagement">{{ report.engagement }}</span>
  <span class="foot-page"></span>
</footer>
{% endif %}

</body>
</html>